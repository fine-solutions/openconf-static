{% from "blocks/accommodation-article.njk" import accommodation with context %}

<main class="accommodation-list">
  {% if accommodations and accommodations.length > 0 %}
    <section id="accommodation" class="accommodation-list__section">
      <h1 class="accommodation-list__heading title">Варианты размещения</h1>
      {% for item in accommodations %}
        {{ accommodation('accommodation-list__accommodation', item) }}
      {% endfor %}
    </section>
  {% endif %}
</main>
